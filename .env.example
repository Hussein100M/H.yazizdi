# قاعدة البيانات — أي مزوّد PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# سرّ توقيع الجلسات — ولّده بـ: openssl rand -base64 32
AUTH_SECRET=""

# العنوان العام للموقع (يُستخدم في روابط SEO وإعادة تعيين كلمة المرور)
NEXT_PUBLIC_SITE_URL="https://example.com"

# مزوّد الدفع: manual | stripe | moyasar | tap
# "manual" = طلب شراء حقيقي ينتظر تأكيد الإدارة — لا يُفعّل أي وصول تلقائياً
PAYMENT_PROVIDER="manual"

# مفاتيح المزوّد — تُملأ عند اختيار مزوّد فعلي. لا تُودع في المستودع أبداً.
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# استضافة الفيديو (اختياري — المنصة تعمل بلا فيديو)
VIDEO_PROVIDER=""
VIDEO_SIGNING_KEY=""
