// نموذج بيانات منصة التصوير المعماري بالذكاء الاصطناعي
// قاعدة البيانات: PostgreSQL (محايدة — تعمل على أي مزوّد يدعم Postgres)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum LessonKind {
  OVERVIEW // شريحة تقديم الوحدة
  CONCEPT // تحدٍّ ← معالجة
  WORKFLOW // خطوات العمل
  SHOWCASE // مثال بصري / قبل-بعد
  PRACTICE // تطبيقات وأفضل ممارسات
}

enum BlockKind {
  PARAGRAPH
  HEADING
  LIST
  SPLIT // عمودان: تحدٍّ / معالجة — أو: يُغيَّر / يُقفل
  STEPS // خطوات مرقّمة
  PROMPT // صيغة برومبت قابلة للنسخ
  COMPARE // مقارنة قبل/بعد بمنزلق
  GALLERY // شبكة صور ببطاقات
  CALLOUT // اقتباس أو مبدأ
  CHECKLIST // قائمة مراجعة تفاعلية
}

enum EnrollmentStatus {
  PENDING // طلب أُنشئ ولم يُدفع بعد
  ACTIVE // وصول كامل
  REVOKED // أُلغي الوصول
}

enum PaymentStatus {
  INITIATED // أُنشئ الطلب لدى المزوّد
  AWAITING_CONFIRMATION // بانتظار تأكيد المزوّد (webhook)
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  enrollments    Enrollment[]
  progress       LessonProgress[]
  payments       Payment[]
  certificates   Certificate[]
  passwordResets PasswordResetToken[]
  loginAttempts  LoginAttempt[]

  @@index([role])
}

// جلسات مخزّنة في قاعدة البيانات: الكوكي يحمل الرمز الخام، وقاعدة البيانات تخزّن تجزئته فقط
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipHash    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// تحديد معدّل محاولات الدخول — يعمل عبر عدة عمليات بخلاف الذاكرة المحلية
model LoginAttempt {
  id         String   @id @default(cuid())
  emailKey   String
  ipHash     String
  successful Boolean  @default(false)
  createdAt  DateTime @default(now())
  userId     String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailKey, createdAt])
  @@index([ipHash, createdAt])
}

model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  titleEn       String
  tagline       String
  summary       String
  heroImage     String
  priceAmount   Int // بالهللات/السنتات — عدد صحيح دائماً
  priceCurrency String   @default("SAR")
  isPublished   Boolean  @default(false)
  instructor    String
  instructorBio String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modules      Module[]
  enrollments  Enrollment[]
  payments     Payment[]
  certificates Certificate[]
}

model Module {
  id       String @id @default(cuid())
  courseId String
  slug     String
  title    String
  titleEn  String
  summary  String
  order    Int
  badge    String // "00" … "06"

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Lesson {
  id           String     @id @default(cuid())
  moduleId     String
  slug         String
  title        String
  titleEn      String?
  summary      String // ملخّص الدرس (من ملاحظات المحاضِر)
  kind         LessonKind @default(CONCEPT)
  order        Int
  minutes      Int        @default(6)
  isPreview    Boolean    @default(false) // متاح بلا تسجيل
  videoAssetId String? // معرّف الفيديو لدى المزوّد — لا رابط مباشر
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  blocks   LessonBlock[]
  progress LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, order])
}

model LessonBlock {
  id       String    @id @default(cuid())
  lessonId String
  kind     BlockKind
  order    Int
  data     Json // حمولة مكتوبة النوع في src/lib/blocks.ts

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  activatedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([userId, courseId])
  @@index([status])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  seconds     Int       @default(0) // آخر موضع مشاهدة بالثواني
  lastSeenAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, lastSeenAt])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  courseId      String
  enrollmentId  String?
  provider      String // "manual" | "stripe" | "moyasar" | "tap" …
  providerRef   String? // معرّف العملية لدى المزوّد
  amount        Int
  currency      String        @default("SAR")
  status        PaymentStatus @default(INITIATED)
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status])
}

// سجل أحداث المزوّد — يمنع معالجة نفس الحدث مرتين
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  externalId  String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
}

model Certificate {
  id         String   @id @default(cuid())
  serial     String   @unique // رقم تحقق عام
  userId     String
  courseId   String
  issuedAt   DateTime @default(now())
  holderName String // الاسم وقت الإصدار — لا يتغير بتغيّر الملف الشخصي

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}
